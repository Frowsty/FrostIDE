//
// Build identification, generated by CMake from build_info.hpp.in at configure
// time. Do not edit the generated copy in the build tree.
#pragma once

#include <string_view>

namespace frost::build_info {

// Detailed product version from version.json (e.g. "2026.11.0.9-beta" or "2026.11.0.1").
inline constexpr std::string_view kVersion = "@FROST_FULL_VERSION@";
// Major product version (year.month, e.g. "2026.11").
inline constexpr std::string_view kMajorVersion = "@FROST_MAJOR_VERSION@";
// Compiler that built this binary, e.g. "Clang 23.1.4".
inline constexpr std::string_view kCompiler = "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@";
// Target operating system name from CMake ("Windows" or "Linux").
inline constexpr std::string_view kSystem = "@CMAKE_SYSTEM_NAME@";

} // namespace frost::build_info
