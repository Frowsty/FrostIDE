// SPDX-License-Identifier: Apache-2.0
//
// Windows resources for frost.exe, generated by CMake from frost.rc.in: the
// application manifest (resource ID 1, type RT_MANIFEST = 24), the glacial
// application icon (resource ID 1, type ICON) and the version information
// shown in Explorer.

1 24 "@FROST_MANIFEST_PATH@"
1 ICON "@FROST_APP_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FrostIDE"
            VALUE "FileDescription", "FrostIDE"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "frost"
            VALUE "LegalCopyright", "Copyright 2026 The FrostIDE authors. Apache-2.0."
            VALUE "OriginalFilename", "frost.exe"
            VALUE "ProductName", "FrostIDE"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
