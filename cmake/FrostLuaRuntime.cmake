include_guard(GLOBAL)
file(READ "${FROST_SOURCE_DIR}/sdk/sdk.lock.json" _frost_lua_lock)
string(JSON _frost_lua_version GET "${_frost_lua_lock}" sources lua54 version)
set(_frost_lua_root "")
if(DEFINED ENV{FROST_SDK} AND NOT "$ENV{FROST_SDK}" STREQUAL "")
    file(TO_CMAKE_PATH "$ENV{FROST_SDK}/lua-${_frost_lua_version}" _frost_lua_root)
endif()
set(FROST_LUA54_ROOT "${_frost_lua_root}" CACHE PATH "Standalone Lua built by tools/build_lua_runtime.py")
if(WIN32)
    set(_frost_lua_leaf lua.exe)
else()
    set(_frost_lua_leaf lua)
endif()
set(_frost_lua_executable "")
if(NOT FROST_LUA54_ROOT STREQUAL "")
    set(_frost_lua_executable "${FROST_LUA54_ROOT}/bin/${_frost_lua_leaf}")
endif()
set(FROST_LUA54_EXECUTABLE "${_frost_lua_executable}" CACHE FILEPATH "Actual Lua5.4 interpreter for native acceptance")
set(FROST_LUA_DEBUG_ADAPTER "" CACHE FILEPATH "Installed complete lua-debug extension bin/lua-debug executable")
function(frost_stage_lua_runtime target)
    if(WIN32)
        set(_frost_lua_stage_leaf lua.exe)
    else()
        set(_frost_lua_stage_leaf lua)
    endif()
    if(NOT EXISTS "${FROST_LUA54_ROOT}/bin/${_frost_lua_stage_leaf}")
        message(STATUS "Standalone Lua is not staged: build the source-pinned runtime or configure an interpreter")
        return()
    endif()
    if(NOT EXISTS "${FROST_LUA54_ROOT}/share/licenses/Lua/lua.h")
        message(FATAL_ERROR "Standalone Lua staging requires its source MIT/copyright notice")
    endif()
    if(WIN32 AND NOT EXISTS "${FROST_LUA54_ROOT}/bin/lua54.dll")
        message(FATAL_ERROR "Standalone Lua needs external lua54.dll API exports, not a static runtime substitution")
    endif()
    if(UNIX AND NOT EXISTS "${FROST_LUA54_ROOT}/bin/liblua54.so")
        message(FATAL_ERROR "Standalone Lua staging needs its matching shared Lua API library")
    endif()
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${FROST_LUA54_ROOT}/bin" "$<TARGET_FILE_DIR:${target}>/lua54"
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${FROST_LUA54_ROOT}/share/licenses/Lua"
                "$<TARGET_FILE_DIR:${target}>/licenses/Lua"
        VERBATIM)
endfunction()
