# Audited generated grammar source recipes (ADR0119); no upstream CMake or generators run.
# This file is evaluated by a later user-authorized configure/build, never during authoring.
set(FROST_LANGUAGE_GRAMMAR_CACHE "${CMAKE_BINARY_DIR}/language-grammar-cache" CACHE PATH "Pinned source archive cache")
option(FROST_FETCH_LANGUAGE_GRAMMARS "Fetch missing audited language grammar source archives" ON)
file(READ "${FROST_SOURCE_DIR}/third_party/language-grammars.lock.json" _frost_grammar_lock)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FROST_SOURCE_DIR}/third_party/language-grammars.lock.json")
function(frost_language_grammar_source id output)
    string(JSON count LENGTH "${_frost_grammar_lock}" grammars)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON candidate GET "${_frost_grammar_lock}" grammars ${index} id)
        if(NOT candidate STREQUAL id)
            continue()
        endif()
        foreach(field IN ITEMS url archiveSha256 archiveRoot license licenseFile licenseSha256)
            string(JSON ${field} GET "${_frost_grammar_lock}" grammars ${index} ${field})
        endforeach()
        if(NOT license STREQUAL "MIT")
            message(FATAL_ERROR "Grammar ${id} license changed; source audit/ADR approval required")
        endif()
        file(SHA256 "${FROST_SOURCE_DIR}/${licenseFile}" actualLicense)
        if(NOT actualLicense STREQUAL licenseSha256)
            message(FATAL_ERROR "Grammar ${id} original license evidence changed")
        endif()
        file(MAKE_DIRECTORY "${FROST_LANGUAGE_GRAMMAR_CACHE}")
        set(archive "${FROST_LANGUAGE_GRAMMAR_CACHE}/${id}-${archiveSha256}.tar.gz")
        if(NOT EXISTS "${archive}")
            if(NOT FROST_FETCH_LANGUAGE_GRAMMARS)
                message(FATAL_ERROR "Missing audited grammar source ${id}; populate FROST_LANGUAGE_GRAMMAR_CACHE or authorize FROST_FETCH_LANGUAGE_GRAMMARS")
            endif()
            file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${archiveSha256}" TLS_VERIFY ON STATUS status)
            list(GET status 0 code)
            if(NOT code EQUAL 0)
                message(FATAL_ERROR "Audited grammar source fetch failed: ${id}: ${status}")
            endif()
        endif()
        file(SHA256 "${archive}" actualArchive)
        if(NOT actualArchive STREQUAL archiveSha256)
            message(FATAL_ERROR "Cached grammar ${id} archive differs from audited pin")
        endif()
        set(parent "${CMAKE_BINARY_DIR}/language-grammar-sources/${id}")
        set(root "${parent}/${archiveRoot}")
        if(NOT EXISTS "${root}/LICENSE")
            file(MAKE_DIRECTORY "${parent}")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${parent}")
        endif()
        string(JSON fileCount LENGTH "${_frost_grammar_lock}" grammars ${index} files)
        math(EXPR fileLast "${fileCount}-1")
        foreach(fileIndex RANGE 0 ${fileLast})
            string(JSON path GET "${_frost_grammar_lock}" grammars ${index} files ${fileIndex} path)
            string(JSON sha256 GET "${_frost_grammar_lock}" grammars ${index} files ${fileIndex} sha256)
            if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)")
                message(FATAL_ERROR "Unsafe audited grammar member path: ${path}")
            endif()
            file(SHA256 "${root}/${path}" actual)
            if(NOT actual STREQUAL sha256)
                message(FATAL_ERROR "Grammar ${id} source changed: ${path}")
            endif()
        endforeach()
        set(${output} "${root}" PARENT_SCOPE)
        return()
    endforeach()
    message(FATAL_ERROR "No audited source recipe for grammar ${id}")
endfunction()
