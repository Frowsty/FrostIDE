{
  "version": 10,
  "$comment": "FrostIDE presets. Run tools/env.ps1 (Windows) or source ~/sdk/env.sh (WSL) first so VCPKG_ROOT, FROST_LLVM_ROOT and FROST_QT_ROOT are set.",
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_PREFIX_PATH": "$env{FROST_QT_ROOT}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win-clangcl",
      "displayName": "Windows, clang-cl + MSVC STL",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-clangcl.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-clangcl",
        "VCPKG_HOST_TRIPLET": "x64-windows-clangcl"
      }
    },
    {
      "name": "win-clangcl-asan",
      "displayName": "Windows, clang-cl, AddressSanitizer (RelWithDebInfo: clang-cl rejects ASan with /MDd)",
      "inherits": "win-clangcl",
      "$comment": "Own vcpkg tree: a manifest install removes every package outside its plan, so two triplets sharing one tree would delete each other's libraries.",
      "cacheVariables": {
        "FROST_SANITIZE": "address",
        "VCPKG_TARGET_TRIPLET": "x64-windows-clangcl-asan",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed-asan"
      }
    },
    {
      "name": "win-clangcl-fuzz",
      "displayName": "Windows, clang-cl, libFuzzer + AddressSanitizer (/MT, RelWithDebInfo)",
      "inherits": "win-clangcl",
      "$comment": "Fuzz targets only (FROST_FUZZ, cmake/FrostFuzz.cmake; ADR 0012): the pinned libFuzzer library needs the static CRT, so the tree builds without Qt and gtest and installs no vcpkg ports.",
      "cacheVariables": {
        "FROST_SANITIZE": "address",
        "FROST_FUZZ": "ON",
        "FROST_BUILD_UI": "OFF",
        "FROST_BUILD_TESTS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, clang + libstdc++ 14",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-clang.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang",
        "VCPKG_HOST_TRIPLET": "x64-linux-clang"
      }
    },
    {
      "name": "linux-clang-asan",
      "displayName": "Linux, clang, ASan + UBSan",
      "inherits": "linux-clang",
      "cacheVariables": { "FROST_SANITIZE": "address;undefined" }
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux, clang, ThreadSanitizer",
      "inherits": "linux-clang",
      "cacheVariables": { "FROST_SANITIZE": "thread" }
    },
    {
      "name": "linux-clang-fuzz",
      "displayName": "Linux, clang, libFuzzer + ASan + UBSan (RelWithDebInfo)",
      "inherits": "linux-clang",
      "$comment": "Fuzz targets only (FROST_FUZZ, cmake/FrostFuzz.cmake; ADR 0012), built like the Windows fuzz tree: no Qt, no gtest, no vcpkg ports.",
      "cacheVariables": {
        "FROST_SANITIZE": "address;undefined",
        "FROST_FUZZ": "ON",
        "FROST_BUILD_UI": "OFF",
        "FROST_BUILD_TESTS": "OFF",
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-clangcl-debug", "configurePreset": "win-clangcl", "configuration": "Debug" },
    { "name": "win-clangcl-release", "configurePreset": "win-clangcl", "configuration": "Release" },
    { "name": "win-clangcl-asan", "configurePreset": "win-clangcl-asan", "configuration": "RelWithDebInfo" },
    { "name": "win-clangcl-fuzz", "configurePreset": "win-clangcl-fuzz", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang", "configuration": "Debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang", "configuration": "Release" },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan", "configuration": "Debug" },
    { "name": "linux-clang-tsan", "configurePreset": "linux-clang-tsan", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-fuzz", "configurePreset": "linux-clang-fuzz", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true, "shortProgress": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    { "name": "win-clangcl-debug", "inherits": "test-base", "configurePreset": "win-clangcl", "configuration": "Debug" },
    { "name": "win-clangcl-release", "inherits": "test-base", "configurePreset": "win-clangcl", "configuration": "Release" },
    { "name": "win-clangcl-asan", "inherits": "test-base", "configurePreset": "win-clangcl-asan", "configuration": "RelWithDebInfo" },
    { "name": "win-clangcl-fuzz", "inherits": "test-base", "configurePreset": "win-clangcl-fuzz", "configuration": "RelWithDebInfo", "filter": { "include": { "label": "fuzz" } } },
    { "name": "linux-clang-debug", "inherits": "test-base", "configurePreset": "linux-clang", "configuration": "Debug" },
    { "name": "linux-clang-release", "inherits": "test-base", "configurePreset": "linux-clang", "configuration": "Release" },
    { "name": "linux-clang-asan", "inherits": "test-base", "configurePreset": "linux-clang-asan", "configuration": "Debug" },
    { "name": "linux-clang-tsan", "inherits": "test-base", "configurePreset": "linux-clang-tsan", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-fuzz", "inherits": "test-base", "configurePreset": "linux-clang-fuzz", "configuration": "RelWithDebInfo", "filter": { "include": { "label": "fuzz" } } }
  ]
}
