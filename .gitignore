# SPDX-License-Identifier: Apache-2.0
#
# Git ignore rules for FrostIDE: build trees, IDE and agent state, tool output.

# Build trees and IDE state.
/build/
/out/
/.vs/
/.idea/
/.vscode/
/.cache/
# Claude Code agent worktrees and local settings.
/.claude/worktrees/
/.claude/settings.local.json
CMakeUserPresets.json
# ...except the CMake presets fixture's user file, which the tests read (ADR 0046).
!/tests/project/fixtures/cmake/presets/CMakeUserPresets.json
compile_commands.json
# Tool logs written into the working directory.
*.log
# Python bytecode from tools/.
__pycache__/
*.pyc
