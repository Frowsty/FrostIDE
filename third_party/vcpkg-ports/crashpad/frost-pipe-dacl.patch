+      L"D:(A;;GA;;;SY)S:(ML;;NW;;;ME)", &sd_size);
 
-  if (!sec_desc)
-    return GetFallbackSecurityDescriptorForNamedPipeInstance(size);
+  CHECK(sec_desc) << "no security descriptor for the handler pipe";
 
   if (size)
     *size = sd_size;
