# Git attributes for FrostIDE: line-ending normalisation and binary markers.

# Normalise text to LF in the repository; Windows-only scripts keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Byte-exact test inputs and goldens are never converted.
tests/**/fixtures/** -text
tests/**/goldens/** -text
tests/fuzz/corpus/** -text
# Pinned third-party assets stay byte-identical to their SHA-256 pins (resources/assets.lock.json).
resources/fonts/** -text
resources/icons/lucide/** -text
# Vendored tree-sitter sources stay byte-identical to their pins (third_party/vendor.lock.json, ADR 0023).
third_party/tree-sitter/** -text
third_party/grammars/** -text
# Vendored libvterm sources, likewise (ADR 0051).
third_party/libvterm/** -text
# Binary assets.
*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.7z binary

# Original licence and third-party notice bytes for the pinned managed server.
third_party/managed-notices/*.txt binary
third_party/managed-notices/*.rtf binary
