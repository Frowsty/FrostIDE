<!-- Owned Roslyn language host. Direct references reuse the previously audited offline assets. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FrostRoslynHost</AssemblyName><Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultItems>true</EnableDefaultItems><RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <Target Name="RequireAuditedRoslyn" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FrostManagedAssets)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll')" Text="FrostManagedAssets must name the existing verified Roslyn 5.9.0 managed payload; no packages are downloaded." />
  </Target>
  <ItemGroup>
    <Reference Include="$(FrostManagedAssets)/*.dll" Exclude="$(FrostManagedAssets)/CSharpLanguageServer.dll;$(FrostManagedAssets)/FSharp*.dll;$(FrostManagedAssets)/Ionide*.dll;$(FrostManagedAssets)/Argu.dll;$(FrostManagedAssets)/ICSharpCode.Decompiler.dll" />
    <Content Include="$(FrostManagedAssets)/BuildHost-netcore/**/*" Link="BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(FrostManagedAssets)/FrostIDE-Notices/**/*" Link="FrostIDE-Notices/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
