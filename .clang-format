# SPDX-License-Identifier: Apache-2.0
# FrostIDE C++ style (PLAN.md section 6.5): LLVM base, 4-space indent, 120 columns.
BasedOnStyle: LLVM
Language: Cpp
Standard: Latest
IndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -4
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All
AllowShortLambdasOnASingleLine: All
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBraces: Attach
DerivePointerAlignment: false
PointerAlignment: Left
FixNamespaceComments: true
IncludeBlocks: Regroup
IncludeCategories:
  # The file's own header first, then frost headers, then third-party, then the standard library.
  - Regex: '^"frost/'
    Priority: 2
  - Regex: '^<(Q|gtest|gmock|benchmark)'
    Priority: 3
  - Regex: '^<[a-z_]+>$'
    Priority: 4
  # Win32: <windows.h> must precede every other SDK header (shellapi.h, ...).
  - Regex: '^<windows\.h>$'
    Priority: 5
  - Regex: '^<[A-Za-z0-9_]+\.h>$'
    Priority: 6
  - Regex: '.*'
    Priority: 3
InsertNewlineAtEOF: true
NamespaceIndentation: None
SortIncludes: CaseSensitive
SpaceAfterTemplateKeyword: false
# clang-format 23 has no rule for C++26 `= delete("reason")` and prints it as
# `= delete ("reason")`; that spelling is accepted rather than fighting the tool.
