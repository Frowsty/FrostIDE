# SPDX-License-Identifier: Apache-2.0
# Editor defaults for the FrostIDE repository (PLAN.md section 6.5).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
