    "Diff": {
      "insertedBackground": "#DBD59F",
      "deletedBackground": "#E8C1A0",
      "modifiedBackground": "#CAD5B7",
      "innerChangeBackground": "#A6C0AB"
    }
  },
  "compact": {
    "Island.arc": 8,
    "Island.gap": 3,
    "Button.height": 24,
    "TextField.height": 24,
    "List.rowHeight": 20,
    "Tree.rowHeight": 20,
    "Menu.itemHeight": 22,
    "TabbedPane.tabHeight": 30,
    "StatusBar.height": 24,
    "ScrollBar.width": 8,
    "Component.paddingH": 6,
    "Layout.margin": 6,
    "Layout.spacing": 4,
    "Toolbar.iconSize": 16
  },
  "icons": {
    "ColorPalette": {
      "Icon.Default": "#504945",
      "Icon.Secondary": "#6A6258",
      "Icon.Accent": "accent",
      "Icon.Error": "#9D0006",
      "Icon.Warning": "#8A5600",
      "Icon.Success": "#5B6300",
      "Icon.Disabled": "#928374",
      "Icon.Selected": "#282828"
    }
  }
}
