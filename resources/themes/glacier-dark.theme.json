      "foreground": "#DFE1E5",
      "caretColor": "#E8EAED",
      "selectionBackground": "#2E4370",
      "currentLineBackground": "#2A2D33",
      "lineNumberForeground": "#6B7079",
      "lineNumberCurrentForeground": "#A9AEB6",
      "searchMatchBackground": "#5A4A1C",
