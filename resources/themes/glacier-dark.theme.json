{
  "name": "Glacier Dark",
  "dark": true,
  "author": "FrostIDE",
  "colors": {
    "window": "#111215",
    "island": "#23252A",
    "popup": "#2A2D33",
    "field": "#1B1D21",
    "text": "#DFE1E5",
    "textSecondary": "#9DA3AD",
    "textDisabled": "#6B7079",
    "border": "#43474E",
    "accent": "#5A9BFF",
    "selection": "#2E4370",
    "white": "#FFFFFF"
