{
  "name": "Glacier High Contrast",
  "dark": true,
  "highContrast": true,
  "author": "FrostIDE",
  "colors": {
    "black": "#000000",
    "white": "#FFFFFF",
    "island": "#1C1C1C",
    "cyan": "#1AEBFF",
    "yellow": "#FFD400"
  },
  "ui": {
    "MainWindow.background": "black",
    "Island": {
      "background": "island",
      "borderColor": "white",
      "arc": 10,
      "gap": 4
    },
    "Popup": {
      "background": "black",
      "borderColor": "white"
    },
    "Separator.color": "white",
    "Label": {
      "foreground": "white",
      "secondaryForeground": "#E0E0E0",
      "disabledForeground": "#A6A6A6"
    },
    "Link.foreground": "#7FD4FF",
    "Component": {
      "borderColor": "white",
      "focusColor": "yellow",
      "disabledBorderColor": "#A6A6A6",
      "arc": 4,
      "focusWidth": 2,
      "paddingH": 8
    },
    "Button": {
      "background": "black",
      "foreground": "white",
      "hoverBackground": "#333333",
      "pressedBackground": "#4D4D4D",
      "arc": 6,
      "height": 28,
      "default": {
        "background": "cyan",
        "foreground": "black",
        "borderColor": "white",
        "hoverBackground": "#7FF3FF"
      }
    },
    "TextField": {
      "background": "black",
      "placeholderForeground": "#D0D0D0",
      "height": 28
    },
    "CheckBox": {
      "borderColor": "white",
      "checkedBackground": "cyan",
      "checkmarkColor": "black"
    },
    "List": {
      "hoverBackground": "#333333",
      "selectionBackground": "cyan",
      "selectionForeground": "black",
      "selectionInactiveBackground": "#A0A0A0",
      "rowHeight": 24
    },
    "Tree.rowHeight": 24,
    "ScrollBar": {
      "thumbColor": "#A6A6A6",
      "thumbHoverColor": "white",
      "trackColor": "black",
      "width": 10
    },
    "ToolTip": {
      "background": "black",
      "foreground": "white",
      "borderColor": "white"
    },
    "Menu.itemHeight": 26,
    "TabbedPane": {
      "underlineColor": "yellow",
      "hoverBackground": "#333333",
      "tabHeight": 36
    },
    "StatusBar.height": 28,
    "Layout": {
      "margin": 8,
      "spacing": 6
    },
    "Icon.size": 16,
    "Toolbar.iconSize": 20,
    "Font": {
      "uiSize": 13,
      "smallSize": 11
    },
    "Window.inactiveAlpha": 0.6,
    "Editor": {
      "foreground": "#FFFFFF",
      "caretColor": "#FFFFFF",
      "selectionBackground": "#1F4FA8",
      "currentLineBackground": "#2A2A2A",
      "lineNumberForeground": "#B8B8B8",
      "lineNumberCurrentForeground": "#FFFFFF",
      "searchMatchBackground": "#6B5200",
      "rightMarginColor": "#5A5A5A",
      "errorMarkerColor": "#FF6B6B",
      "warningMarkerColor": "#FFD24D",
      "inactiveCodeForeground": "#9A9A9A",
      "weakWarningMarkerColor": "#E0D8A0",
      "infoMarkerColor": "#8CC4FF",
      "cleanMarkerColor": "#7CF08C",
      "errorStripeBackground": "#000000",
      "searchMatchStripeColor": "#FFD24D",
      "usageHighlightBackground": "#30405A",
      "writeUsageHighlightBackground": "#5A3040",
      "usageStripeColor": "#C8D8FF",
      "inspectionWidgetBackground": "#1A1A1A",
      "inspectionWidgetForeground": "#FFFFFF"
    },
    "Syntax": {
      "keyword": "#8CC4FF",
      "comment": "#C8C8C8",
      "docComment": "#B5E3B0",
      "string": "#A8F0A0",
      "stringEscape": "#FFD27A",
      "number": "#F0B8FF",
      "type": "#7FF0E6",
      "builtinType": "#8CC4FF",
      "function": "#FFE48A",
      "macro": "#E0C4FF",
      "property": "#D8CCFF",
      "attribute": "#E0C4FF",
      "tag": "#8CC4FF",
      "heading": "#8CC4FF",
      "link": "#8CC4FF"
    },
    "Semantic": {
      "localVariable": "#FFFFFF",
      "parameter": "#FFC08A",
      "field": "#D8CCFF",
      "staticField": "#D8CCFF",
      "globalVariable": "#F0B8FF",
      "constant": "#F0B8FF",
      "function": "#FFE48A",
      "method": "#FFE48A",
      "staticMethod": "#FFE48A",
      "class": "#7FF0E6",
      "enum": "#7FF0E6",
      "enumerator": "#F0B8FF",
      "namespace": "#C4DCFF",
      "macro": "#E0C4FF",
      "templateParameter": "#90F0C0",
      "concept": "#90F0C0",
      "typeAlias": "#90E0F0"
    }
  },
  "compact": {
    "Island.arc": 8,
    "Island.gap": 3,
    "Button.height": 24,
    "TextField.height": 24,
    "List.rowHeight": 20,
    "Tree.rowHeight": 20,
    "Menu.itemHeight": 22,
    "TabbedPane.tabHeight": 30,
    "StatusBar.height": 24,
    "ScrollBar.width": 8,
    "Component.paddingH": 6,
    "Layout.margin": 6,
    "Layout.spacing": 4,
    "Toolbar.iconSize": 16
  },
  "icons": {
    "ColorPalette": {
      "Icon.Default": "white",
      "Icon.Secondary": "#E0E0E0",
      "Icon.Accent": "yellow",
      "Icon.Error": "#FF9C9C",
      "Icon.Warning": "yellow",
      "Icon.Success": "#8CFF8C",
      "Icon.Disabled": "#A6A6A6",
      "Icon.Selected": "black"
    }
  }
}
