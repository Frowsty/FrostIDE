# Restore the five prior-baseline managed integration cases from explicit, verified local tools.
include_guard(GLOBAL)

# Produces one JSON string without treating native paths or semicolons as CMake list separators.
function(_frost_managed_json_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Same arguments and target policy as frost_add_test. Only this function's target inherits the
# launcher. Discovery and unrelated cases pass through; missing required fixture inputs fail.
# Cache values or explicit runtime variables select reviewed installations without downloading.
function(frost_add_managed_fixture_test name)
    set(lock_path "${FROST_SOURCE_DIR}/sdk/sdk.lock.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lock_path}")
    file(READ "${lock_path}" lock)
    if(WIN32)
        set(platform windows)
        set(dotnet_name dotnet.exe)
        set(adapter_name netcoredbg.exe)
    else()
        set(platform linux)
        set(dotnet_name dotnet)
        set(adapter_name netcoredbg)
    endif()
    string(JSON dotnet_version GET "${lock}" ${platform} dotnet version)
    string(JSON server_version GET "${lock}" managedServer version)
    set(sdk_root "$ENV{FROST_SDK}")
    set(server_root "$ENV{FROST_MANAGED_SERVER_DIR}")
    if(NOT server_root AND sdk_root)
        set(server_root "${sdk_root}/managed")
    endif()
    set(debug_root "$ENV{FROST_MANAGED_DEBUG_DIR}")
    set(default_dotnet "")
    set(default_archive "")
    if(sdk_root)
        set(default_dotnet "${sdk_root}/dotnet-${dotnet_version}/${dotnet_name}")
        set(default_archive "${sdk_root}/_downloads/csharp-ls.${server_version}.nupkg")
    endif()
    set(default_server "")
    if(server_root)
        set(default_server "${server_root}/CSharpLanguageServer.dll")
    endif()
    set(default_adapter "")
    set(default_guard "")
    if(debug_root)
        set(default_adapter "${debug_root}/adapter/${adapter_name}")
        set(default_guard "${debug_root}/PdbGuard/PdbGuard.dll")
    endif()
    set(FROST_TEST_CSHARP_DOTNET "${default_dotnet}" CACHE FILEPATH "Pinned managed fixture dotnet executable")
    set(FROST_TEST_CSHARP_SERVER "${default_server}" CACHE FILEPATH "Reviewed csharp-ls fixture entry assembly")
    set(FROST_TEST_CSHARP_ARCHIVE "${default_archive}" CACHE FILEPATH "Pinned offline csharp-ls NuGet archive")
    set(FROST_TEST_MANAGED_DEBUG_ADAPTER "${default_adapter}" CACHE FILEPATH "Reviewed source-built managed fixture adapter")
    set(FROST_TEST_MANAGED_DEBUG_GUARD "${default_guard}" CACHE FILEPATH "PdbGuard from the same reviewed payload")
    set(FROST_MANAGED_DEBUG_MANIFEST_SHA256 "$ENV{FROST_MANAGED_DEBUG_MANIFEST_SHA256}" CACHE STRING
        "Independent reviewed managed payload build-record digest")
    set(tools "")
    set(separator "")
    foreach(key IN ITEMS FROST_TEST_CSHARP_DOTNET FROST_TEST_CSHARP_SERVER FROST_TEST_CSHARP_ARCHIVE
            FROST_TEST_MANAGED_DEBUG_ADAPTER FROST_TEST_MANAGED_DEBUG_GUARD FROST_MANAGED_DEBUG_MANIFEST_SHA256)
        _frost_managed_json_string(value "${${key}}")
        string(APPEND tools "${separator}\"${key}\":${value}")
        set(separator ",")
    endforeach()
    _frost_managed_json_string(source_root "${FROST_SOURCE_DIR}")
    if(name STREQUAL "lang_managed_tests")
        set(cases "\"ManagedE2E.InheritedProfilePreservesCustomNugetFeed\":[\"sdk\"],\n"
            "\"ManagedE2E.UnsavedCrossProjectUtf16NavigationAndRename\":[\"sdk\",\"server\"]")
    elseif(name STREQUAL "app_workbench_managed_tests")
        set(cases "\"WorkbenchManaged.RealConsoleProjectBuildsAndDebugsWithVerifiedSource\":[\"sdk\",\"debugger\"],\n"
            "\"WorkbenchManaged.TrustAndUnsavedCrossProjectRenameReachEditors\":[\"sdk\",\"server\"],\n"
            "\"WorkbenchManaged.UnityGenerationReloadReplaysDirtyDocuments\":[\"sdk\",\"server\"]")
    else()
        message(FATAL_ERROR "Managed fixture launcher has no case inventory for ${name}")
    endif()
    string(JOIN "" cases ${cases})
    set(configuration "${CMAKE_CURRENT_BINARY_DIR}/${name}-managed-fixture.json")
    file(WRITE "${configuration}" "{\"schemaVersion\":1,\"sourceRoot\":${source_root},\"tools\":{${tools}},\"cases\":{\n"
        "${cases}}}\n")
    if(WIN32 AND NOT Python3_EXECUTABLE AND sdk_root)
        set(Python3_EXECUTABLE "${sdk_root}/py/Scripts/python.exe")
    endif()
    find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
    set(CMAKE_TEST_LAUNCHER "${Python3_EXECUTABLE}" -B "${FROST_SOURCE_DIR}/tools/managed_fixture.py"
        --config "${configuration}" --)
    frost_add_test(${name} ${ARGN})
endfunction()
