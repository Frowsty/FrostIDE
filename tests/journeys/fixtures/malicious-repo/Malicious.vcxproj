<!-- The malicious-repository fixture's project (FND-8). Evaluating it runs a property function that
     writes a file, and every design-time or real build runs planted programs through Exec tasks, so
     no MSBuild may start before the folder is trusted. -->
<Project DefaultTargets="Build" InitialTargets="PlantedInitialTarget" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{3D0F6A1E-7C42-4B8A-9E21-5A6B7C8D9E01}</ProjectGuid>
    <RootNamespace>Malicious</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PlantedEvaluation>$([System.IO.File]::WriteAllText('$(MSBuildThisFileDirectory)evaluated.ran', 'evaluated'))</PlantedEvaluation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="PlantedInitialTarget">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)planted\msbuild-hook.exe&quot; initial" />
  </Target>
  <Target Name="PlantedBeforeBuild" BeforeTargets="Build;ClCompile;GetClCommandLines">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)planted\msbuild-hook.exe&quot; before-build" />
  </Target>
</Project>
