{
  "version": 6,
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Ninja", "binaryDir": "${sourceDir}/out/${presetName}"},
    {"name": "on-windows", "inherits": "base", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "on-linux", "inherits": "base", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "not-darwin", "inherits": "base", "condition": {"type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Darwin"}},
    {"name": "in-list", "inherits": "base",
     "condition": {"type": "inList", "string": "$env{FROST_ORACLE_FLAVOUR}", "list": ["red", "blue"]}},
    {"name": "not-in-list", "inherits": "base",
     "condition": {"type": "notInList", "string": "$env{FROST_ORACLE_FLAVOUR}", "list": ["red", "blue"]}},
    {"name": "matches", "inherits": "base", "condition": {"type": "matches", "string": "${sourceDirName}", "regex": "^cond"}},
    {"name": "not-matches", "inherits": "base", "condition": {"type": "notMatches", "string": "$penv{FROST_ORACLE_FLAVOUR}", "regex": "^bl+ue$"}},
    {"name": "any-of", "inherits": "base",
     "condition": {"type": "anyOf", "conditions": [{"type": "const", "value": false},
                                                   {"type": "equals", "lhs": "$env{FROST_ORACLE_FLAVOUR}", "rhs": "blue"}]}},
    {"name": "all-of", "inherits": "base",
     "condition": {"type": "allOf", "conditions": [{"type": "const", "value": true},
                                                   {"type": "equals", "lhs": "$env{FROST_ORACLE_FLAVOUR}", "rhs": "red"}]}},
    {"name": "not-not", "inherits": "base",
     "condition": {"type": "not", "condition": {"type": "not", "condition": {"type": "const", "value": true}}}},
    {"name": "null-condition", "inherits": "base", "condition": null},
    {"name": "const-false", "inherits": "base", "condition": {"type": "const", "value": false}},
    {"name": "plain-false", "inherits": "base", "condition": false},
    {"name": "own-environment", "inherits": "base", "environment": {"FROST_ORACLE_LOCAL": "here-$env{FROST_ORACLE_FLAVOUR}"},
     "condition": {"type": "equals", "lhs": "$env{FROST_ORACLE_LOCAL}", "rhs": "here-blue"}},
    {"name": "parent-environment-only", "inherits": "base", "environment": {"FROST_ORACLE_FLAVOUR": "green"},
     "condition": {"type": "equals", "lhs": "$penv{FROST_ORACLE_FLAVOUR}", "rhs": "blue"}},
    {"name": "overridden-environment", "inherits": "base", "environment": {"FROST_ORACLE_FLAVOUR": "green"},
     "condition": {"type": "equals", "lhs": "$env{FROST_ORACLE_FLAVOUR}", "rhs": "blue"}},
    {"name": "dollar", "inherits": "base", "condition": {"type": "equals", "lhs": "${dollar}{x}", "rhs": "$${x}"}},
    {"name": "double-dollar-as-written", "inherits": "base", "condition": {"type": "equals", "lhs": "$${x}", "rhs": "${dollar}${dollar}{x}"}},
    {"name": "double-dollar-env-as-written", "inherits": "base",
     "condition": {"type": "equals", "lhs": "$$env{FROST_ORACLE_FLAVOUR}", "rhs": "${dollar}${dollar}env{FROST_ORACLE_FLAVOUR}"}},
    {"name": "unknown-namespace-inner-macro", "inherits": "base",
     "condition": {"type": "equals", "lhs": "$a{${sourceDirName}}-$e{x}-$ {y}-$x", "rhs": "${dollar}a{conditions}-${dollar}e{x}-${dollar} {y}-${dollar}x"}},
    {"name": "trailing-dollar", "inherits": "base", "condition": {"type": "equals", "lhs": "end$", "rhs": "end${dollar}"}},
    {"name": "vendor-macro-ignores-the-preset", "inherits": "base",
     "condition": {"type": "equals", "lhs": "$vendor{example.com/x}", "rhs": "$vendor{example.com/x}"}},
    {"name": "vendor-macro-in-a-cache-variable", "inherits": "base", "cacheVariables": {"V": "$vendor{example.com/x}"}},
    {"name": "inherits-a-false-condition", "inherits": ["const-false"]},
    {"name": "own-condition-wins", "inherits": ["const-false"], "condition": true},
    {"name": "preset-name", "inherits": "base", "condition": {"type": "matches", "string": "${presetName}", "regex": "^preset-"}},
    {"name": "generator", "inherits": "base", "condition": {"type": "equals", "lhs": "${generator}", "rhs": "Ninja"}}
  ],
  "buildPresets": [
    {"name": "build-on-windows", "configurePreset": "not-darwin",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "build-blue", "configurePreset": "not-darwin",
     "condition": {"type": "inList", "string": "$env{FROST_ORACLE_FLAVOUR}", "list": ["blue"]}},
    {"name": "build-not-blue", "configurePreset": "not-darwin",
     "condition": {"type": "notInList", "string": "$env{FROST_ORACLE_FLAVOUR}", "list": ["blue"]}}
  ]
}
