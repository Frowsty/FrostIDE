<?xml version="1.0" encoding="utf-8"?>
<!-- A user property sheet (the project's ImportGroup Label="PropertySheets") of the engine
     libraries: Core's public include directory and a shared header item. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(GenRoot)Core\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GEN_ENGINE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="$(GenRoot)shared\config.h" />
  </ItemGroup>
</Project>
