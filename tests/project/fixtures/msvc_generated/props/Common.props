<?xml version="1.0" encoding="utf-8"?>
<!-- Level 1 of the synthetic solution's property-sheet chain: a define for every project, then the
     toolchain sheet. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>GEN_COMMON=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Release builds define NDEBUG, as Visual Studio's generated projects do (SLN-7's switch test). -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(MSBuildThisFileDirectory)Toolchain.props" />
</Project>
