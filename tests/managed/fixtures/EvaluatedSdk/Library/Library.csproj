  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'"><DefineConstants>$(DefineConstants);MODERN_TFM</DefineConstants></PropertyGroup>
  <ItemGroup><Compile Remove="Removed.cs" /><Compile Include="../Shared/Linked.cs" Link="Shared/Linked.cs" /></ItemGroup>
</Project>
