<?xml version="1.0" encoding="utf-8"?>
<!-- A synthetic SDK property sheet: an include directory under $(FROST_TEST_SDK_ROOT) (an
     environment variable) and a define, as employer SDK sheets add them. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FROST_TEST_SDK_ROOT)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>FROST_SDK_FEATURE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
